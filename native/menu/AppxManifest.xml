<?xml version="1.0" encoding="utf-8"?>
<!-- Version stays 1.0.0.0 across app updates: registering needs admin rights once, and the DLL itself updates with the app.
     Sparse package: gives Filerrrr.exe (installed normally) the package identity Windows 11 needs
     for a top-level File Explorer menu entry. The files stay in the install folder (external location). -->
<Package xmlns="http://schemas.microsoft.com/appx/manifest/foundation/windows10"
         xmlns:uap="http://schemas.microsoft.com/appx/manifest/uap/windows10"
         xmlns:uap10="http://schemas.microsoft.com/appx/manifest/uap/windows10/10"
         xmlns:desktop4="http://schemas.microsoft.com/appx/manifest/desktop/windows10/4"
         xmlns:desktop5="http://schemas.microsoft.com/appx/manifest/desktop/windows10/5"
         xmlns:com="http://schemas.microsoft.com/appx/manifest/com/windows10"
         xmlns:rescap="http://schemas.microsoft.com/appx/manifest/foundation/windows10/restrictedcapabilities"
         IgnorableNamespaces="uap uap10 desktop4 desktop5 com rescap">
  <!-- This publisher OID marks the package as unsigned, which Windows 11 accepts with Add-AppxPackage -AllowUnsigned -->
  <Identity Name="Filerrrr.ExplorerMenu" Publisher="CN=Filerrrr, OID.2.25.311729368913984317654407730594956997722=1"
            Version="1.0.0.0" ProcessorArchitecture="x64" />
  <Properties>
    <DisplayName>Filerrrr</DisplayName>
    <PublisherDisplayName>Filerrrr</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
    <uap10:AllowExternalContent>true</uap10:AllowExternalContent>
  </Properties>
  <Resources><Resource Language="en-us" /></Resources>
  <Dependencies>
    <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.22000.0" MaxVersionTested="10.0.26100.0" />
  </Dependencies>
  <Capabilities><rescap:Capability Name="runFullTrust" /></Capabilities>
  <Applications>
    <Application Id="Filerrrr" Executable="Filerrrr.exe" uap10:TrustLevel="mediumIL" uap10:RuntimeBehavior="win32App">
      <uap:VisualElements AppListEntry="none" DisplayName="Filerrrr" Description="Convert files with Filerrrr"
                          BackgroundColor="transparent" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" />
      <Extensions>
        <desktop4:Extension Category="windows.fileExplorerContextMenus">
          <desktop4:FileExplorerContextMenus>
            <desktop5:ItemType Type="*">
              <desktop5:Verb Id="FilerrrrConvert" Clsid="C1D5D6B0-3F0E-4E8A-9A5B-6F7E2A1C4B11" />
            </desktop5:ItemType>
          </desktop4:FileExplorerContextMenus>
        </desktop4:Extension>
        <com:Extension Category="windows.comServer">
          <com:ComServer>
            <com:SurrogateServer DisplayName="Filerrrr menu">
              <com:Class Id="C1D5D6B0-3F0E-4E8A-9A5B-6F7E2A1C4B11" Path="filerrrr_menu.dll" ThreadingModel="STA" />
            </com:SurrogateServer>
          </com:ComServer>
        </com:Extension>
      </Extensions>
    </Application>
  </Applications>
</Package>
