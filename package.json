{
  "name": "filerrrr",
  "productName": "Filerrrr",
  "version": "1.2.2",
  "description": "Convert files on your PC: hold Ctrl, drag, pick a format on the palette.",
  "main": "main.cjs",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node --test tests/*.test.cjs",
    "test:electron": "electron tests/electron-suite.cjs",
    "test:app": "electron tests/app-control.cjs",
    "test:packaged": "electron tests/packaged-pdf.cjs",
    "test:e2e": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/e2e/run.ps1",
    "icon": "node scripts/make-icon.cjs",
    "dist": "npm run menu && npm run native && npm run engines && electron-builder --win nsis --x64",
    "native": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-drop.ps1",
    "engines": "node scripts/engine-pack.cjs",
    "core:config": "node scripts/core-config.cjs",
    "notices": "node scripts/notices.cjs",
    "menu": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-menu.ps1",
    "test:menu": "powershell -NoProfile -ExecutionPolicy Bypass -File tests/e2e/menu.ps1 -Invoke"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.1.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@tmcw/togeojson": "^7.1.3",
    "@xmldom/xmldom": "^0.9.12",
    "ag-psd": "^34.1.0",
    "electron-updater": "6.8.11",
    "exceljs": "^4.4.0",
    "fast-xml-parser": "^5.12.0",
    "ffmpeg-static": "^5.3.0",
    "fonteditor-core": "^2.6.3",
    "heic-decode": "^2.1.0",
    "html-to-docx": "^1.8.0",
    "imagetracerjs": "^1.2.6",
    "js-yaml": "^5.5.0",
    "jszip": "^3.10.2",
    "koffi": "^3.3.7",
    "mammoth": "^1.13.0",
    "marked": "^18.2.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^6.5.438",
    "postal-mime": "^4.2.1",
    "sharp": "^0.35.5",
    "smol-toml": "^1.9.1",
    "tesseract.js": "7.0.0",
    "turndown": "^7.2.5",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "electron": "^45.3.0",
    "electron-builder": "^26.18.0"
  },
  "build": {
    "appId": "com.filerrrr.app",
    "productName": "Filerrrr",
    "electronLanguages": [
      "en-US",
      "en-GB"
    ],
    "asar": false,
    "copyright": "Filerrrr",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.cjs",
      "updates.cjs",
      "preferences.cjs",
      "recipes.cjs",
      "watch-folders.cjs",
      "edits.cjs",
      "THIRD-PARTY-NOTICES.txt",
      "selection.cjs",
      "picks.cjs",
      "native-drop.cjs",
      "engine-packs.cjs",
      "engine-pack-manifest.json",
      "preload.cjs",
      "convert.cjs",
      "conversion-client.cjs",
      "conversion-worker.cjs",
      "undo.cjs",
      "test-profile.cjs",
      "capabilities.cjs",
      "formats.js",
      "features.js",
      "gesture.cjs",
      "contextmenu.cjs",
      "store.cjs",
      "topmenu.cjs",
      "engines/**",
      "renderer/**",
      "build/icon.png",
      "build/icon.ico",
      "!**/*.map"
    ],
    "asarUnpack": [
      "engines/ocr-worker.cjs",
      "engines/ocr-engine-worker.cjs",
      "node_modules/sharp/**",
      "node_modules/@img/**",
      "node_modules/ffmpeg-static/**",
      "node_modules/uiohook-napi/**",
      "node_modules/koffi/**",
      "node_modules/@napi-rs/**",
      "node_modules/pdfjs-dist/**",
      "node_modules/tesseract.js/**",
      "node_modules/tesseract.js-core/**",
      "node_modules/@tesseract.js-data/**",
      "node_modules/wasm-feature-detect/**",
      "node_modules/regenerator-runtime/**",
      "node_modules/is-url/**",
      "node_modules/bmp-js/**"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "executableName": "Filerrrr"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Filerrrr",
      "include": "build/installer.nsh",
      "artifactName": "Filerrrr-Setup-${version}.${ext}",
      "uninstallDisplayName": "Filerrrr"
    },
    "extraFiles": [
      {
        "from": "build/filerrrr_drop.dll",
        "to": "filerrrr_drop.dll"
      },
      {
        "from": "build/menu",
        "to": ".",
        "filter": [
          "filerrrr_menu.dll",
          "Filerrrr.ExplorerMenu.msix"
        ]
      }
    ]
  },
  "overrides": {
    "uuid": "^11.1.1",
    "image-size": "^2.0.3"
  },
  "author": "Filerrrr"
}
